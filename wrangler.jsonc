{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "anime-frame-quiz-cloudflare",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // user: visitor-provided key; site: DEEPSEEK_API_KEY Worker Secret
    "DEEPSEEK_API_KEY_MODE": "site"
  },
  "routes": [
    {
      "pattern": "animeframequiz.cn",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false
    },
    {
      "pattern": "www.animeframequiz.cn",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // 只让需要 Worker 逻辑的路径先进 Worker：HTML 入口（www→裸域 301）、
    // 图库 JSON（合并管理员启停状态）；CSS/JS/封面等纯静态资源由资产 CDN 直出
    "run_worker_first": [
      "/api/*",
      "/robots.txt",
      "/sitemap.xml",
      "/",
      "/*.html",
      "/data/anime-library.json"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "anime-frame-quiz-leaderboard",
      "database_id": "a7f27479-5c95-4db8-9838-ff21b55e4d18",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    // 排行/反馈/访问数据已改为永久保留，不再需要定时清理任务
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.05
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
