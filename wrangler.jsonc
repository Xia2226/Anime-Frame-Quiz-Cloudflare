{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "anime-frame-quiz-cloudflare",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "anime-frame-quiz-leaderboard",
      "database_id": "a7f27479-5c95-4db8-9838-ff21b55e4d18",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["17 16 * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.05
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
