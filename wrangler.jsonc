{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "anime-frame-quiz-cloudflare",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-03",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
