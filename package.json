{
  "name": "anime-frame-quiz-cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test",
    "check:data": "node tools/validate-anime-library.mjs",
    "check:js": "node tools/check-javascript.mjs",
    "check:deploy": "wrangler deploy --dry-run",
    "db:migrate:local": "wrangler d1 migrations apply anime-frame-quiz-leaderboard --local",
    "db:migrate:remote": "wrangler d1 migrations apply anime-frame-quiz-leaderboard --remote",
    "check": "npm test && npm run check:data && npm run check:js && npm run check:deploy"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "wrangler": "^4.118.0"
  }
}
